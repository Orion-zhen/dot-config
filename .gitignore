# Machine-local settings and application state.
.DS_Store

/clight/.config/clight.d/*
!/clight/.config/clight.d/*.example

/clipse/.config/clipse/*
!/clipse/.config/clipse/config.json
!/clipse/.config/clipse/custom_theme.json

/fish/.config/fish/fish_variables
/fish/.config/fish/conf.d/custom.fish

/git/.config/git/*
!/git/.config/git/config

/hypr/.config/hypr/land/monitors.conf
/hyprpanel/.config/hyprpanel/*
!/hyprpanel/.config/hyprpanel/config.json

/niri/.config/niri/conf.d/outputs.kdl

/nvim/.config/nvim/lazy-lock.json
/nvim/.config/nvim/lazyvim.json
/nvim/.config/nvim/nvim-pack-lock.json

/systemd/.config/systemd/*
!/systemd/.config/systemd/user/
/systemd/.config/systemd/user/*
!/systemd/.config/systemd/user/*.service

# Generated theme files.
**/*dank*
**/*dms*
