# Machine-local settings and application state.
.DS_Store

/clight.d/*
!/clight.d/*.example

/clipse/*
!/clipse/config.json
!/clipse/custom_theme.json

/fish/fish_variables
/fish/conf.d/custom.fish

/git/*
!/git/config

/hypr/land/monitors.conf
/hyprpanel/*
!/hyprpanel/config.json

/niri/conf.d/outputs.kdl

/nvim/lazy-lock.json
/nvim/lazyvim.json
/nvim/nvim-pack-lock.json

/systemd/*
!/systemd/user/
/systemd/user/*
!/systemd/user/*.service

# Generated theme files.
**/*dank*
**/*dms*
